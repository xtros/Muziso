{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muziso",
  "version": "0.1.0",
  "identifier": "com.jts.muziso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muziso",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "gstreamer/**/*",
      "bin/yt-dlp.exe"
    ],
    "externalBin": [
      "binaries/spotiflac-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gist.githubusercontent.com/xtros/53b5965cc67d39cd7f721c714ade0309/raw/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QkU5RUM2OEM0NjQ5MDYKUldRR1NVYU14cDYrU0VRdVVwVHVRMlFVcTg3UTVld0o1d2tFMnJoT3dub0JCekNEMzFOcmNIbUYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}